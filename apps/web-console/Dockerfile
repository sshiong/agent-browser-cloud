FROM node:20-bookworm-slim AS build
WORKDIR /workspace
ARG VITE_AUTH_MODE
ARG VITE_LOCAL_ROLES
ARG VITE_TENANT_ID
ARG VITE_ACTOR_ID
ARG VITE_ENABLE_FIXTURES
ARG VITE_API_BASE_URL
ARG VITE_OIDC_AUTHORITY
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_REDIRECT_URI
ARG VITE_OIDC_POST_LOGOUT_REDIRECT_URI
ARG VITE_OIDC_SCOPE
ARG VITE_OIDC_ROLES_CLAIM
ARG VITE_OIDC_TENANT_CLAIM
ENV VITE_AUTH_MODE=${VITE_AUTH_MODE}
ENV VITE_LOCAL_ROLES=${VITE_LOCAL_ROLES}
ENV VITE_TENANT_ID=${VITE_TENANT_ID}
ENV VITE_ACTOR_ID=${VITE_ACTOR_ID}
ENV VITE_ENABLE_FIXTURES=${VITE_ENABLE_FIXTURES}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_OIDC_AUTHORITY=${VITE_OIDC_AUTHORITY}
ENV VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID}
ENV VITE_OIDC_REDIRECT_URI=${VITE_OIDC_REDIRECT_URI}
ENV VITE_OIDC_POST_LOGOUT_REDIRECT_URI=${VITE_OIDC_POST_LOGOUT_REDIRECT_URI}
ENV VITE_OIDC_SCOPE=${VITE_OIDC_SCOPE}
ENV VITE_OIDC_ROLES_CLAIM=${VITE_OIDC_ROLES_CLAIM}
ENV VITE_OIDC_TENANT_CLAIM=${VITE_OIDC_TENANT_CLAIM}
RUN corepack enable
COPY apps/web-console/package.json apps/web-console/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web-console ./
RUN pnpm build

FROM nginxinc/nginx-unprivileged:1.27-alpine
ARG VITE_OIDC_AUTHORITY
COPY --chown=101:101 apps/web-console/nginx.conf /tmp/default.conf.template
RUN OIDC_CONNECT_SRC="${VITE_OIDC_AUTHORITY}" \
    envsubst '${OIDC_CONNECT_SRC}' < /tmp/default.conf.template > /etc/nginx/conf.d/default.conf \
    && rm /tmp/default.conf.template
COPY --from=build /workspace/dist /usr/share/nginx/html
EXPOSE 8080
