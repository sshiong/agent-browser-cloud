diff --git a/core/rfb.js b/core/rfb.js
--- a/core/rfb.js
+++ b/core/rfb.js
@@ -475,0 +476,2 @@
+        this._sendAgentBrowserInputFrame();
+
@@ -491,0 +494,6 @@
+    _sendAgentBrowserInputFrame() {
+        if (this._agentBrowserDisplayedFrameId?.length === 8) {
+            RFB.messages.clientFence(this._sock, 0, "ABCI" + this._agentBrowserDisplayedFrameId);
+        }
+    }
+
@@ -501,0 +510,2 @@
+
+        this._sendAgentBrowserInputFrame();
@@ -1208,0 +1219,2 @@
+
+        this._sendAgentBrowserInputFrame();
@@ -2258,0 +2271,2 @@
+        // Private Agent Browser input-frame capability; other RFB servers ignore it.
+        encs.push(-0x41424349);
@@ -2531 +2545,17 @@
-        RFB.messages.clientFence(this._sock, flags, payload);
+        if (payload.startsWith("ABCF") && (payload.length === 8 || payload.length === 16)) {
+            // A normal Fence reply only proves protocol parsing. The gateway's private frame
+            // fence is replied to after queued image decoding/drawing and the next browser
+            // animation frame. Do not acknowledge an abandoned connection.
+            this._display.flush().then(() => {
+                window.requestAnimationFrame(() => {
+                    if (this._rfbConnectionState === 'connected') {
+                        if (payload.length === 16) {
+                            this._agentBrowserDisplayedFrameId = payload.slice(8);
+                        }
+                        RFB.messages.clientFence(this._sock, flags, payload);
+                    }
+                });
+            });
+        } else {
+            RFB.messages.clientFence(this._sock, flags, payload);
+        }
