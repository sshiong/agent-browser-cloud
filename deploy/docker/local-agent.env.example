# Copy these values into your shell or a private env file. Never commit the API key file.
LOCAL_AGENT_MODEL_API_KEY_FILE=/absolute/path/to/model-api-key
LOCAL_AGENT_MODEL_ENDPOINT=https://your-model-provider.example/v1/responses
LOCAL_AGENT_MODEL_NAME=your-reviewed-model-deployment
# Optional: set when the Provider returns a canonical model ID for the requested alias.
LOCAL_AGENT_MODEL_RESPONSE_NAME=
LOCAL_AGENT_MODEL_REVISION=your-pinned-model-revision
# Optional for slow on-premise model gateways; Worker clamps this to 1..300 seconds.
LOCAL_AGENT_MODEL_TIMEOUT_SECONDS=120
# Provider-side reasoning and visible output budget; accepted range is 64..4096.
LOCAL_AGENT_MODEL_MAXIMUM_OUTPUT_TOKENS=512
