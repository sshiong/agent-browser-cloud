{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Browser Cloud",
  "version": "0.1.0",
  "identifier": "io.browsercloud.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web-console dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "pnpm --dir ../web-console build",
    "frontendDist": "../../web-console/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8080 ws://127.0.0.1:6080",
        "font-src": "'self' data:",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Agent Browser Cloud",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agentbrowsercloud"]
      }
    }
  }
}
