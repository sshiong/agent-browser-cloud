{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browsercloud.io/schemas/error-envelope-v1.json",
  "title": "Agent Browser Cloud Error Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "details", "requestId", "timestamp"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
