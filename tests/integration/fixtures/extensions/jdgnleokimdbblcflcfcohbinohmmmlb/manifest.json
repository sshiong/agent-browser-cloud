{
  "manifest_version": 3,
  "name": "Agent Browser Integration Extension",
  "version": "1.0.0",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
