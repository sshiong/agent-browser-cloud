# The three required Local Compose settings. Never commit this file with a real key.
LOCAL_AGENT_MODEL_ENDPOINT=https://your-model-provider.example/v1
LOCAL_AGENT_MODEL_API_KEY=your-provider-key
LOCAL_AGENT_MODEL_NAME=your-model-or-aggregate-alias
# The system appends /responses to a /v1 Base URL. A legacy full /v1/responses URL also works.
# Local Compose accepts HTTP endpoints for trusted local/LAN/third-party development Providers.
# HTTP sends the API key and request content without transport encryption; never use it on an untrusted network.
# Optional safer alternative to LOCAL_AGENT_MODEL_API_KEY:
# LOCAL_AGENT_MODEL_API_KEY_FILE=/absolute/path/to/model-api-key
# Optional: set when the Provider returns a canonical model ID for the requested alias.
LOCAL_AGENT_MODEL_RESPONSE_NAME=
# Optional deployment metadata; defaults to local-v1.
LOCAL_AGENT_MODEL_REVISION=local-v1
# Optional for slow on-premise model gateways; Worker clamps this to 1..300 seconds.
LOCAL_AGENT_MODEL_TIMEOUT_SECONDS=120
# Provider-side reasoning and visible output budget; accepted range is 64..4096.
LOCAL_AGENT_MODEL_MAXIMUM_OUTPUT_TOKENS=512
