# Same-origin API path used by the browser bundle. Do not put secrets in Vite variables.
VITE_API_BASE_URL=/api/v1

# Local Vite proxy target. Production Nginx proxies /api to the Control Plane service.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Development-only tenant guard. This is not authentication.
VITE_TENANT_ID=tenant-local

# Optional UI fixture visibility for modules whose backend contract is not implemented.
# Keep disabled in production.
VITE_ENABLE_FIXTURES=false
