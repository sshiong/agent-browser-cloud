# Non-secret deployment settings. Copy to .env, configure it, then run ./personal-secure init.
PERSONAL_PORT=3000
PERSONAL_OIDC_ISSUER=https://id.example.com/realms/browsercloud
PERSONAL_OIDC_CLIENT_ID=browsercloud-web
PERSONAL_OIDC_AUDIENCE=browsercloud-api
PERSONAL_OIDC_SCOPE=openid profile offline_access
PERSONAL_OIDC_TENANT_CLAIM=tenant_id
PERSONAL_OIDC_ROLES_CLAIM=roles
PERSONAL_PROXY_EXPECTED_EXIT_IP=203.0.113.10
PERSONAL_PROXY_EXIT_CHECK_URL=https://api.ipify.org
PERSONAL_OBJECT_STORAGE_ENDPOINT=https://s3.example.com
PERSONAL_OBJECT_STORAGE_HOST=s3.example.com
PERSONAL_OBJECT_STORAGE_BUCKET=browsercloud-personal
PERSONAL_OBJECT_STORAGE_REGION=us-east-1
PERSONAL_OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
PERSONAL_MODEL_ENDPOINT=https://api.openai.com/v1/responses
PERSONAL_MODEL_HOST=api.openai.com
PERSONAL_MODEL_NAME=gpt-5-mini
PERSONAL_MODEL_REVISION=personal-v1

# Absolute source files copied into isolated named volumes by secret-init.
PERSONAL_OBJECT_STORAGE_SECRET_ACCESS_KEY_FILE=/absolute/path/object-storage-secret
PERSONAL_MODEL_API_KEY_FILE=/absolute/path/model-api-key
PERSONAL_AGENT_WORKER_TOKEN_FILE=/absolute/path/agent-worker.jwt
PERSONAL_REVIEWER_WORKER_TOKEN_FILE=/absolute/path/reviewer-worker.jwt
PERSONAL_OUTCOME_VERIFIER_WORKER_TOKEN_FILE=/absolute/path/outcome-verifier-worker.jwt
PERSONAL_VISION_WORKER_TOKEN_FILE=/absolute/path/vision-worker.jwt
